# Copy to .env and fill in. Never commit .env.

# Groq — chat completions for /api/chat (llama-3.3-70b-versatile)
GROQ_API_KEY=

# Google Gemini — embeddings (text-embedding-004) for `npm run embed` and query-time retrieval
GEMINI_API_KEY=

# Resend — transactional email (not wired yet)
RESEND_API_KEY=

# Public portfolio origin for social metadata and sitemap (include https://).
NEXT_PUBLIC_SITE_URL=

# Public résumé PDF link shown in contact actions. Leave blank for email requests.
RESUME_URL=

# Optional calendar link used by the unlisted coffee page
CAL_URL=
